// SPDX-License-Identifier: Apache-2.0
// Immutable upstream sources; project build adapter only.
package { default_applicable_licenses: ["libure_harfbuzz_license"] }
license {
    name: "libure_harfbuzz_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-MIT", "SPDX-license-identifier-ISC", "SPDX-license-identifier-Unicode-3.0"],
    license_text: ["COPYING", "src/ms-use/COPYING", "src/hb-ucd.cc", "Unicode-LICENSE.txt"],
}
cc_library_static {
    name: "libure_harfbuzz",
    recovery_available: true,
    vendor_available: true,
    host_supported: true,
    srcs: [
        "src/OT/Var/VARC/VARC.cc",
        "src/hb-aat-layout.cc",
        "src/hb-aat-map.cc",
        "src/hb-blob.cc",
        "src/hb-buffer-serialize.cc",
        "src/hb-buffer-verify.cc",
        "src/hb-buffer.cc",
        "src/hb-common.cc",
        "src/hb-coretext-font.cc",
        "src/hb-coretext-shape.cc",
        "src/hb-coretext.cc",
        "src/hb-directwrite-font.cc",
        "src/hb-directwrite-shape.cc",
        "src/hb-directwrite.cc",
        "src/hb-draw.cc",
        "src/hb-face-builder.cc",
        "src/hb-face.cc",
        "src/hb-fallback-shape.cc",
        "src/hb-font.cc",
        "src/hb-ft.cc",
        "src/hb-gdi.cc",
        "src/hb-glib.cc",
        "src/hb-graphite2.cc",
        "src/hb-map.cc",
        "src/hb-number.cc",
        "src/hb-ot-cff1-table.cc",
        "src/hb-ot-cff2-table.cc",
        "src/hb-ot-color.cc",
        "src/hb-ot-face.cc",
        "src/hb-ot-fetch.cc",
        "src/hb-ot-font.cc",
        "src/hb-ot-layout.cc",
        "src/hb-ot-map.cc",
        "src/hb-ot-math.cc",
        "src/hb-ot-meta.cc",
        "src/hb-ot-metrics.cc",
        "src/hb-ot-name.cc",
        "src/hb-ot-shape-fallback.cc",
        "src/hb-ot-shape-normalize.cc",
        "src/hb-ot-shape.cc",
        "src/hb-ot-shaper-arabic.cc",
        "src/hb-ot-shaper-default.cc",
        "src/hb-ot-shaper-hangul.cc",
        "src/hb-ot-shaper-hebrew.cc",
        "src/hb-ot-shaper-indic-table.cc",
        "src/hb-ot-shaper-indic.cc",
        "src/hb-ot-shaper-khmer.cc",
        "src/hb-ot-shaper-myanmar.cc",
        "src/hb-ot-shaper-syllabic.cc",
        "src/hb-ot-shaper-thai.cc",
        "src/hb-ot-shaper-use.cc",
        "src/hb-ot-shaper-vowel-constraints.cc",
        "src/hb-ot-tag.cc",
        "src/hb-ot-var.cc",
        "src/hb-outline.cc",
        "src/hb-paint-bounded.cc",
        "src/hb-paint-extents.cc",
        "src/hb-paint.cc",
        "src/hb-set.cc",
        "src/hb-shape-plan.cc",
        "src/hb-shape.cc",
        "src/hb-shaper.cc",
        "src/hb-static.cc",
        "src/hb-style.cc",
        "src/hb-ucd.cc",
        "src/hb-unicode.cc",
        "src/hb-uniscribe.cc",
        "src/hb-wasm-api.cc",
        "src/hb-wasm-shape.cc",
    ],
    local_include_dirs: ["src"],
    export_include_dirs: ["src"],
    cflags: [
        "-DHAVE_FREETYPE",
        "-DHB_CUSTOM_MALLOC",
        "-DHB_NO_GETENV",
        "-DHB_NO_SETLOCALE",
        "-DHB_NO_DRAW",
        "-DHB_NO_AAT",
        "-DHB_NO_BUFFER_SERIALIZE",
        "-DHB_NO_BUFFER_VERIFY",
        "-DHB_BUFFER_MAX_LEN_FACTOR=4",
        "-DHB_BUFFER_MAX_LEN_MIN=8192",
        "-DHB_BUFFER_MAX_LEN_DEFAULT=32768",
        "-DHB_BUFFER_MAX_OPS_FACTOR=256",
        "-DHB_BUFFER_MAX_OPS_MIN=65536",
        "-DHB_BUFFER_MAX_OPS_DEFAULT=2097152",
        "-DHB_SANITIZE_MAX_OPS_MAX=2097152",
    ],
    shared_libs: ["libft2"],
    cpp_std: "c++17",
}
