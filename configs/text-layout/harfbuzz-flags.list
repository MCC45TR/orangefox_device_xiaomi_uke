-DHAVE_FREETYPE
-DHB_CUSTOM_MALLOC
-DHB_NO_GETENV
-DHB_NO_SETLOCALE
-DHB_NO_DRAW
-DHB_NO_AAT
-DHB_NO_BUFFER_SERIALIZE
-DHB_NO_BUFFER_VERIFY
-DHB_BUFFER_MAX_LEN_FACTOR=4
-DHB_BUFFER_MAX_LEN_MIN=8192
-DHB_BUFFER_MAX_LEN_DEFAULT=32768
-DHB_BUFFER_MAX_OPS_FACTOR=256
-DHB_BUFFER_MAX_OPS_MIN=65536
-DHB_BUFFER_MAX_OPS_DEFAULT=2097152
-DHB_SANITIZE_MAX_OPS_MAX=2097152
