+#ifdef TW_UKE_NATIVE_THEME
+void DataManager::QueuePreferences()
+{
+  if (GetIntValue("ure_preferences_loaded") != 1) return;
+  if (!uke_preferences_dirty.exchange(false)) return;
+  std::lock_guard<std::mutex> ownership(uke_preferences_writer_lock);
+  if (uke_preferences_stopped) return;
+  if (!uke_preferences_writer)
+    uke_preferences_writer = std::make_unique<ure::PreferenceWriter>([] { (void)DataManager::Flush(); });
+  uke_preferences_writer->request();
+}
+
+int DataManager::ShutdownPreferences()
+{
+  std::unique_ptr<ure::PreferenceWriter> writer;
+  {
+    std::lock_guard<std::mutex> ownership(uke_preferences_writer_lock);
+    uke_preferences_stopped = true;
+    writer = std::move(uke_preferences_writer);
+  }
+  writer.reset(); // Drain and join before the cache, GUI queue or reboot disappears.
+  return Flush();
+}
+#endif
+
 int DataManager::SaveValues()
 {
+#ifdef TW_UKE_NATIVE_THEME
+  std::lock_guard<std::mutex> ownership(uke_preferences_state);
+  if (android::base::GetProperty("ro.twrp.fastbootd", "") == "1") return -1;
+  if (GetIntValue("ure_preferences_loaded") != 1) return -1;
+  pthread_mutex_lock(&m_valuesLock);
+  const auto values = mPersist.Values();
+  const auto generation = uke_preferences_generation.load();
+  pthread_mutex_unlock(&m_valuesLock);
+  ure::Value preferences(Json::objectValue);
+  for (const auto& entry : values)
+    if (ure::ui_preference_key(entry.first)) preferences[entry.first] = entry.second;
+  const auto serialized = ure::json(preferences);
+  if (serialized == uke_preferences_saved) {
+    gui_run_on_main([generation] {
+      if (uke_preferences_generation.load() == generation)
+        DataManager::SetValue("ure_preferences_status", "Recovery preferences saved and verified.");
+    });
+    return 0;
+  }
+  try {
+    (void)ure::ui_preferences_save(preferences);
+    uke_preferences_saved = serialized;
+    gui_run_on_main([generation] {
+      if (uke_preferences_generation.load() == generation)
+        DataManager::SetValue("ure_preferences_status", "Recovery preferences saved and verified.");
+    });
+    return 0;
+  } catch (const ure::Error&) {
+    gui_run_on_main([generation] {
+      if (uke_preferences_generation.load() == generation)
+        DataManager::SetValue("ure_preferences_status", "Applied for this session; persistent storage is unavailable.");
+    });
+    fprintf(stderr, "UI preferences were not saved; retaining the last complete record.\n");
+    return -1;
+  }
+#endif
