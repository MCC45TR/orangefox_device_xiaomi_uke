+++ b/ure-fbe-gcm.hpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "ure-fbe-parser.hpp"
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <memory>
+#include <optional>
+#include <vector>
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+
+namespace ure_fbe {
+
+class SecretBuffer {
+    unsigned char* data_ = nullptr;
+    size_t size_ = 0, capacity_ = 0;
+public:
+    SecretBuffer() = default;
+    // Adopt a caller-owned malloc allocation whose capacity is already known.
+    SecretBuffer(unsigned char* data, size_t capacity) : data_(data), size_(capacity), capacity_(capacity) {}
+    SecretBuffer(const SecretBuffer&) = delete;
+    SecretBuffer& operator=(const SecretBuffer&) = delete;
+    ~SecretBuffer() { clear(); }
+    void clear() {
+        if (data_) {
+            OPENSSL_cleanse(data_, capacity_);
+            ::free(data_);
+        }
+        data_ = nullptr;
+        size_ = capacity_ = 0;
+    }
+    bool allocate(size_t capacity) {
+        clear();
+        if (capacity == 0 || capacity > kMaxStateBytes + EVP_MAX_BLOCK_LENGTH) return false;
+        data_ = static_cast<unsigned char*>(::malloc(capacity));
+        if (!data_) return false;
+        size_ = capacity_ = capacity;
+        return true;
+    }
+    void truncate(size_t size) {
+        if (!data_ || size > size_) return;
+        OPENSSL_cleanse(data_ + size, size_ - size);
+        size_ = size;
+    }
+    unsigned char* data() { return data_; }
+    const unsigned char* data() const { return data_; }
+    size_t size() const { return size_; }
+    size_t capacity() const { return capacity_; }
+};
+
+class ScopedOptionalCleanse {
+    std::optional<std::vector<uint8_t>>& bytes_;
+public:
+    explicit ScopedOptionalCleanse(std::optional<std::vector<uint8_t>>& bytes) : bytes_(bytes) {}
+    ScopedOptionalCleanse(const ScopedOptionalCleanse&) = delete;
+    ScopedOptionalCleanse& operator=(const ScopedOptionalCleanse&) = delete;
+    ~ScopedOptionalCleanse() {
+        if (bytes_ && !bytes_->empty()) OPENSSL_cleanse(bytes_->data(), bytes_->size());
+    }
+};
+
+inline bool DecryptGcm(const std::optional<std::vector<uint8_t>>& input,
+                       const unsigned char* key, size_t keySize, SecretBuffer* output) {
+    if (!output) return false;
+    output->clear();
+    if (!key || keySize != 32 || !input) return false;
+    if (input->empty()) return false;
+    GcmPayload payload;
+    if (!ParseGcmPayload(std::string_view(reinterpret_cast<const char*>(input->data()), input->size()), &payload)) return false;
+    if (!output->allocate(payload.ciphertext.size() + EVP_MAX_BLOCK_LENGTH)) return false;
+    const auto reject = [&]() { output->clear(); return false; };
+    std::unique_ptr<EVP_CIPHER_CTX, decltype(&EVP_CIPHER_CTX_free)> ctx(EVP_CIPHER_CTX_new(), &EVP_CIPHER_CTX_free);
+    if (!ctx) return reject();
+    if (EVP_DecryptInit_ex(ctx.get(), EVP_aes_256_gcm(), nullptr, nullptr, nullptr) != 1 ||
+        EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_IVLEN, kGcmIvBytes, nullptr) != 1 ||
+        EVP_DecryptInit_ex(ctx.get(), nullptr, nullptr, key,
+            reinterpret_cast<const unsigned char*>(payload.iv.data())) != 1) return reject();
+    int produced = 0, finalSize = 0;
+    if (EVP_DecryptUpdate(ctx.get(), output->data(), &produced,
+            reinterpret_cast<const unsigned char*>(payload.ciphertext.data()),
+            static_cast<int>(payload.ciphertext.size())) != 1 || produced < 0 ||
+        static_cast<size_t>(produced) > output->capacity()) return reject();
+    std::array<unsigned char, kGcmTagBytes> tag;
+    std::copy(payload.tag.begin(), payload.tag.end(), tag.begin());
+    if (EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_TAG, kGcmTagBytes, tag.data()) != 1)
+        return reject();
+    // GCM may emit unauthenticated plaintext during Update. Publish it only
+    // after Final authenticates the stored tag; every failure clears it.
+    if (EVP_DecryptFinal_ex(ctx.get(), output->data() + produced, &finalSize) != 1)
+        return reject();
+    if (finalSize < 0 || static_cast<size_t>(finalSize) > output->capacity() - static_cast<size_t>(produced))
+        return reject();
+    output->truncate(static_cast<size_t>(produced) + static_cast<size_t>(finalSize));
+    return true;
+}
+
+} // namespace ure_fbe
