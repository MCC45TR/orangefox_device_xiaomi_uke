+bool twrpTruetype::gr_ttf_setLocale(const char* locale) {
+	Lock lock;
+	if (!locale || strnlen(locale,33) > 32) return false;
+	static const char* const supported[]{
+		"ar-SA", "bg-BG", "bn-BD", "ca-ES", "cs-CZ", "de-DE", "el-GR", "en", "es-ES", "fa-IR", "fr-FR",
+		"he-IL", "hi-IN", "hu", "id-ID", "it-IT", "ja-JP", "ko-KR", "nl-NL", "no-NO", "pl-PL", "pt-BR",
+		"pt-PT", "ro-RO", "ru", "sr-Cyrl", "th-TH", "tr-TR", "uk-UA", "vi-VN", "zh-CN", "zh-TW"
+	};
+	try {
+		std::string requested(locale);
+		std::replace(requested.begin(), requested.end(), '_', '-');
+		if (std::find(std::begin(supported), std::end(supported), requested) == std::end(supported)) return false;
+		if (text_locale == requested) return true;
+		text_locale = std::move(requested);
+		for (auto& item : font_data.fonts)
+			while (!item.second->string_cache.empty()) erase_string(item.second);
+		return true;
+	} catch (const std::bad_alloc&) { return false; }
+}
