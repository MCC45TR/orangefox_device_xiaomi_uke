+bool twrpTruetype::gr_ttf_setFallbackDirectory(const char* directory) {
+	Lock lock;
+	if (!font_data.fonts.empty() || !directory || strnlen(directory,4097) > 4096) return false;
+	struct stat info{};
+	if (lstat(directory, &info) || !S_ISDIR(info.st_mode)) return false;
+	try { fallback_directory = directory; return true; }
+	catch (const std::bad_alloc&) { return false; }
