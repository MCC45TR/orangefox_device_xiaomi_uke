+bool retrieveExistingKeyReadOnly(const std::string& dir, const KeyAuthentication& auth,
+                                KeyBuffer* key) {
+    if (!key || auth.secret.size() > 65536) return false;
+    *key = KeyBuffer{};
+    android::base::unique_fd directory(open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    struct stat info{};
+    struct statvfs filesystem{};
+    if (directory.get() < 0 || fstat(directory.get(), &info) != 0 || info.st_uid != 0 ||
+        fstatvfs(directory.get(), &filesystem) != 0 || (filesystem.f_flag & ST_RDONLY) == 0)
+        return false;
+    if (auth.usesKeystore()) {
+        MetadataKeyBinding binding;
+        {
+            const std::lock_guard<std::mutex> lock(storage_binding_info.guard);
+            // An absent seed can only try the unbound application ID. A bound
+            // installation still needs its actual seed; authentication must pass.
+            binding = storage_binding_info.state == StorageBindingInfo::State::IN_USE
+                          ? MetadataKeyBinding::Bound : MetadataKeyBinding::Unbound;
+        }
+        return retrieveMetadataKeyReadOnly(directory.get(), binding, key);
+    }
+    struct SecretRecords {
+        std::string version, secdiscardable, encrypted, hash, app_id;
+        ~SecretRecords() {
+            for (auto* value : {&version, &secdiscardable, &encrypted, &hash, &app_id})
+                if (!value->empty()) OPENSSL_cleanse(value->data(), value->size());
+        }
+    } records;
+    struct stat pending{};
+    if (fstatat(directory.get(), kFn_keymaster_key_blob_upgraded, &pending, AT_SYMLINK_NOFOLLOW) == 0 ||
+        errno != ENOENT ||
+        !readMetadataKeyFile(directory.get(), kFn_version, 1, &records.version) ||
+        records.version != kCurrentVersion ||
+        !readMetadataKeyFile(directory.get(), kFn_secdiscardable, SECDISCARDABLE_BYTES, &records.secdiscardable) ||
+        records.secdiscardable.size() != SECDISCARDABLE_BYTES ||
+        !readMetadataKeyFile(directory.get(), kFn_encrypted_key, 65536, &records.encrypted) ||
+        records.encrypted.size() <= GCM_NONCE_BYTES + GCM_MAC_BYTES) return false;
+    hashWithPrefix(kHashPrefix_secdiscardable, records.secdiscardable, &records.hash);
+    records.app_id = generateAppId(auth, records.hash);
+    if (!decryptWithoutKeystore(records.app_id, records.encrypted, key)) {
+        *key = KeyBuffer{};
+        return false;
+    }
