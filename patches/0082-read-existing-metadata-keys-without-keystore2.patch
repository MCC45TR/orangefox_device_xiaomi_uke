+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#ifndef __ANDROID_RECOVERY__
+#error "ExistingKeyMint is a recovery-only client; normal Android uses Keystore2."
+#endif
+
+#include "KeyBuffer.h"
+#include <aidl/android/hardware/security/keymint/ErrorCode.h>
+#include <aidl/android/hardware/security/keymint/IKeyMintDevice.h>
+#include <string_view>
+
+namespace android::vold {
+namespace km = ::aidl::android::hardware::security::keymint;
+
+// Existing metadata keys only. This client never starts a service or upgrades a key.
+class ExistingKeyMint {
+  public:
+    ExistingKeyMint();
+    explicit operator bool() const { return device_ != nullptr; }
+    km::ErrorCode errorCode() const { return error_; }
+    bool decryptMetadata(std::string_view blob, std::string_view app_id,
+                         std::string_view nonce, std::string_view body_and_tag, KeyBuffer* key);
+    bool exportWrapped(const KeyBuffer& blob, KeyBuffer* key);
+
+  private:
+    bool accepted(const ::ndk::ScopedAStatus& status);
+    std::shared_ptr<km::IKeyMintDevice> device_;
+    km::ErrorCode error_ = km::ErrorCode::UNKNOWN_ERROR;
+};
+}  // namespace android::vold
