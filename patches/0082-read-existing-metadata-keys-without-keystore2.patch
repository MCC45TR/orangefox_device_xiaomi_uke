+bool retrieveMetadataKeyReadOnly(int key_dir_fd, MetadataKeyBinding binding, KeyBuffer* key) {
+    if (!key) return false;
+    *key = KeyBuffer{};
+    struct stat directory{};
+    struct statvfs filesystem{};
+    if ((binding != MetadataKeyBinding::Unbound && binding != MetadataKeyBinding::Bound) ||
+        key_dir_fd < 0 || fstat(key_dir_fd, &directory) != 0 || !S_ISDIR(directory.st_mode) ||
+        directory.st_uid != 0 || fstatvfs(key_dir_fd, &filesystem) != 0 ||
+        (filesystem.f_flag & ST_RDONLY) == 0) return false;
+    struct Records {
+        std::string version, secdiscardable, encrypted, blob, hash, app_id, nonce, body;
+        ~Records() {
+            for (auto* value : {&version, &secdiscardable, &encrypted, &blob, &hash, &app_id, &nonce, &body})
+                if (!value->empty()) OPENSSL_cleanse(value->data(), value->size());
+        }
+    } records;
+    if (!readMetadataKeyFile(key_dir_fd, kFn_version, 1, &records.version) ||
+        records.version != kCurrentVersion ||
+        !readMetadataKeyFile(key_dir_fd, kFn_secdiscardable, SECDISCARDABLE_BYTES, &records.secdiscardable) ||
+        records.secdiscardable.size() != SECDISCARDABLE_BYTES ||
+        !readMetadataKeyFile(key_dir_fd, kFn_encrypted_key, 65536, &records.encrypted) ||
+        records.encrypted.size() <= GCM_NONCE_BYTES + GCM_MAC_BYTES ||
+        !readMetadataKeyFile(key_dir_fd, kFn_keymaster_key_blob, 65536, &records.blob)) return false;
+    // An upgrade left on disk requires Android to settle it; recovery never chooses or commits it.
+    struct stat pending{};
+    if (fstatat(key_dir_fd, kFn_keymaster_key_blob_upgraded, &pending, AT_SYMLINK_NOFOLLOW) == 0 ||
+        errno != ENOENT) return false;
+    hashWithPrefix(kHashPrefix_secdiscardable, records.secdiscardable, &records.hash);
+    {
+        const std::lock_guard<std::mutex> lock(storage_binding_info.guard);
+        const bool bound = binding == MetadataKeyBinding::Bound;
+        if (bound) {
+            if (storage_binding_info.state != StorageBindingInfo::State::IN_USE ||
+                storage_binding_info.seed.empty() || storage_binding_info.seed.size() > 65472)
+                return false;
+        } else if (storage_binding_info.state == StorageBindingInfo::State::IN_USE) {
+            return false;
+        }
+        records.app_id = records.hash;
+        if (bound) records.app_id.append(storage_binding_info.seed.begin(), storage_binding_info.seed.end());
+    }
+    ExistingKeyMint keymint;
+    if (!keymint) return false;
+    records.nonce = records.encrypted.substr(0, GCM_NONCE_BYTES);
+    records.body.assign(records.encrypted.data() + GCM_NONCE_BYTES,
+                        records.encrypted.size() - GCM_NONCE_BYTES);
+    return keymint.decryptMetadata(records.blob, records.app_id, records.nonce, records.body, key);
+}
