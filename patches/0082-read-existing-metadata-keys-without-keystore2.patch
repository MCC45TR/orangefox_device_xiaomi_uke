+// SPDX-License-Identifier: Apache-2.0
+#include "ExistingKeyMint.h"
+
+#include <android/binder_manager.h>
+#include <keymint_support/authorization_set.h>
+#include <openssl/mem.h>
+#include <algorithm>
+
+namespace android::vold {
+namespace {
+constexpr size_t kMaxBlob = 65536;
+constexpr size_t kMaxKey = 512;
+struct SecretBytes {
+    std::vector<uint8_t> bytes;
+    ~SecretBytes() { if (!bytes.empty()) OPENSSL_cleanse(bytes.data(), bytes.size()); }
+};
+struct SecretParameters {
+    std::vector<km::KeyParameter> values;
+    ~SecretParameters() {
+        for (auto& parameter : values) {
+            if (parameter.value.getTag() != km::KeyParameterValue::blob) continue;
+            auto& bytes = parameter.value.get<km::KeyParameterValue::blob>();
+            if (!bytes.empty()) OPENSSL_cleanse(bytes.data(), bytes.size());
+        }
+    }
+};
+struct Operation {
+    std::shared_ptr<km::IKeyMintOperation> operation;
+    ~Operation() { if (operation) operation->abort(); }
+};
+
+bool metadataCharacteristicsSafe(const std::vector<km::KeyCharacteristics>& groups) {
+    if (groups.empty() || groups.size() > 2) return false;
+    unsigned required = 0;
+    bool tee = false, software = false;
+    std::vector<km::Tag> seen;
+    for (const auto& group : groups) {
+        if (group.securityLevel == km::SecurityLevel::TRUSTED_ENVIRONMENT) {
+            if (tee) return false;
+            tee = true;
+        } else if (group.securityLevel == km::SecurityLevel::SOFTWARE) {
+            if (software) return false;
+            software = true;
+        } else return false;
+        if (group.authorizations.size() > 64) return false;
+        for (const auto& parameter : group.authorizations) {
+            const auto type = parameter.value.getTag();
+            if (parameter.tag != km::Tag::PURPOSE &&
+                std::find(seen.begin(), seen.end(), parameter.tag) != seen.end()) return false;
+            seen.push_back(parameter.tag);
+            unsigned bit = 0;
+            switch (parameter.tag) {
+                case km::Tag::ALGORITHM:
+                    if (type != km::KeyParameterValue::algorithm ||
+                        parameter.value.get<km::KeyParameterValue::algorithm>() != km::Algorithm::AES) return false;
+                    bit = 1; break;
+                case km::Tag::KEY_SIZE:
+                    if (type != km::KeyParameterValue::integer ||
+                        parameter.value.get<km::KeyParameterValue::integer>() != 256) return false;
+                    bit = 2; break;
+                case km::Tag::BLOCK_MODE:
+                    if (type != km::KeyParameterValue::blockMode ||
+                        parameter.value.get<km::KeyParameterValue::blockMode>() != km::BlockMode::GCM) return false;
+                    bit = 4; break;
+                case km::Tag::PADDING:
+                    if (type != km::KeyParameterValue::paddingMode ||
+                        parameter.value.get<km::KeyParameterValue::paddingMode>() != km::PaddingMode::NONE) return false;
+                    bit = 8; break;
+                case km::Tag::MIN_MAC_LENGTH:
+                    if (type != km::KeyParameterValue::integer ||
+                        parameter.value.get<km::KeyParameterValue::integer>() != 128) return false;
+                    bit = 16; break;
+                case km::Tag::NO_AUTH_REQUIRED:
+                    if (type != km::KeyParameterValue::boolValue ||
+                        !parameter.value.get<km::KeyParameterValue::boolValue>()) return false;
+                    bit = 32; break;
+                case km::Tag::PURPOSE:
+                    if (type != km::KeyParameterValue::keyPurpose) return false;
+                    if (parameter.value.get<km::KeyParameterValue::keyPurpose>() == km::KeyPurpose::DECRYPT) bit = 64;
+                    else if (parameter.value.get<km::KeyParameterValue::keyPurpose>() == km::KeyPurpose::ENCRYPT) bit = 128;
+                    else return false;
+                    if (required & bit) return false;
+                    break;
+                case km::Tag::ROLLBACK_RESISTANCE:
+                case km::Tag::CALLER_NONCE:
+                    if (type != km::KeyParameterValue::boolValue ||
+                        !parameter.value.get<km::KeyParameterValue::boolValue>()) return false;
+                    break;
+                case km::Tag::ORIGIN:
+                    if (type != km::KeyParameterValue::origin ||
+                        parameter.value.get<km::KeyParameterValue::origin>() != km::KeyOrigin::GENERATED) return false;
+                    break;
+                case km::Tag::OS_VERSION:
+                case km::Tag::OS_PATCHLEVEL:
+                case km::Tag::VENDOR_PATCHLEVEL:
+                case km::Tag::BOOT_PATCHLEVEL:
+                    if (type != km::KeyParameterValue::integer ||
+                        parameter.value.get<km::KeyParameterValue::integer>() < 0) return false;
+                    break;
+                default:
+                    // Unknown restrictions, authentication and use limits must not reach begin().
+                    return false;
+            }
+            if (bit && group.securityLevel != km::SecurityLevel::TRUSTED_ENVIRONMENT) return false;
+            required |= bit;
+        }
+    }
+    return tee && required == 255;
+}
+}  // namespace
+
+bool ExistingKeyMint::accepted(const ::ndk::ScopedAStatus& status) {
+    error_ = status.isOk() ? km::ErrorCode::OK :
+        status.getExceptionCode() == EX_SERVICE_SPECIFIC ?
+            static_cast<km::ErrorCode>(status.getServiceSpecificError()) :
+            km::ErrorCode::UNKNOWN_ERROR;
+    return status.isOk();
+}
+
+ExistingKeyMint::ExistingKeyMint() {
+    ::ndk::SpAIBinder binder(AServiceManager_checkService(
+        "android.hardware.security.keymint.IKeyMintDevice/default"));
+    auto device = km::IKeyMintDevice::fromBinder(binder);
+    if (!device) return;
+    int32_t version = 0;
+    km::KeyMintHardwareInfo info;
+    if (!accepted(device->getInterfaceVersion(&version))) return;
+    if (version < 2 || version > 4) {
+        error_ = km::ErrorCode::HARDWARE_TYPE_UNAVAILABLE;
+        return;
+    }
+    if (!accepted(device->getHardwareInfo(&info))) return;
+    if (info.securityLevel != km::SecurityLevel::TRUSTED_ENVIRONMENT) {
+        error_ = km::ErrorCode::HARDWARE_TYPE_UNAVAILABLE;
+        return;
+    }
+    device_ = std::move(device);
+}
+
+bool ExistingKeyMint::decryptMetadata(std::string_view blob, std::string_view app_id,
+                                     std::string_view nonce, std::string_view body_and_tag,
+                                     KeyBuffer* key) {
+    if (!key) { error_ = km::ErrorCode::INVALID_ARGUMENT; return false; }
+    const auto overlaps = [&](std::string_view input) {
+        if (input.empty() || key->empty()) return false;
+        const auto source = reinterpret_cast<uintptr_t>(input.data());
+        const auto destination = reinterpret_cast<uintptr_t>(key->data());
+        return source >= destination ? source - destination < key->size() :
+                                       destination - source < input.size();
+    };
+    if (overlaps(blob) || overlaps(app_id) || overlaps(nonce) || overlaps(body_and_tag)) {
+        error_ = km::ErrorCode::INVALID_ARGUMENT;
+        return false;
+    }
+    if (!key->empty()) OPENSSL_cleanse(key->data(), key->size());
+    key->clear();
+    if (!device_ || blob.empty() || blob.size() > kMaxBlob || app_id.empty() ||
+        app_id.size() > kMaxBlob || nonce.size() != 12 || body_and_tag.size() <= 16 ||
+        body_and_tag.size() > kMaxKey + 16) {
+        error_ = km::ErrorCode::INVALID_ARGUMENT;
+        return false;
+    }
+    SecretBytes key_blob{{blob.begin(), blob.end()}};
+    SecretBytes application_id{{app_id.begin(), app_id.end()}};
+    std::vector<km::KeyCharacteristics> characteristics;
+    if (!accepted(device_->getKeyCharacteristics(key_blob.bytes, application_id.bytes, {},
+                                                 &characteristics))) return false;
+    if (!metadataCharacteristicsSafe(characteristics)) {
+        error_ = km::ErrorCode::INVALID_ARGUMENT;
+        return false;
+    }
+    SecretBytes input{{body_and_tag.begin(), body_and_tag.end()}}, output;
+    SecretParameters params{{
+        km::Authorization(km::TAG_BLOCK_MODE, km::BlockMode::GCM),
+        km::Authorization(km::TAG_PADDING, km::PaddingMode::NONE),
+        km::Authorization(km::TAG_MAC_LENGTH, 128),
+        km::Authorization(km::TAG_APPLICATION_ID,
+                          std::vector<uint8_t>(app_id.begin(), app_id.end())),
+        km::Authorization(km::TAG_NONCE, std::vector<uint8_t>(nonce.begin(), nonce.end())),
+    }};
+    km::BeginResult begin;
+    const auto status = device_->begin(km::KeyPurpose::DECRYPT, key_blob.bytes,
+                                       params.values, std::nullopt, &begin);
+    Operation scope{begin.operation};
+    if (!accepted(status)) return false;
+    if (!scope.operation) {
+        error_ = km::ErrorCode::UNKNOWN_ERROR;
+        return false;
+    }
+    // Keep plaintext private until GCM authentication succeeds in finish().
+    if (!accepted(scope.operation->finish(input.bytes, std::nullopt, std::nullopt,
+                                         std::nullopt, std::nullopt, &output.bytes))) return false;
+    scope.operation.reset();
+    if (output.bytes.empty() || output.bytes.size() > kMaxKey ||
+        output.bytes.size() + 16 != body_and_tag.size()) {
+        error_ = km::ErrorCode::INVALID_ARGUMENT;
+        return false;
+    }
+    key->assign(output.bytes.begin(), output.bytes.end());
+    return true;
+}
+
+bool ExistingKeyMint::exportWrapped(const KeyBuffer& blob, KeyBuffer* key) {
+    if (!key) { error_ = km::ErrorCode::INVALID_ARGUMENT; return false; }
+    // The existing wrapped input may be the destination; refuse instead of erasing it.
+    if (&blob == key) { error_ = km::ErrorCode::INVALID_ARGUMENT; return false; }
+    if (!key->empty()) OPENSSL_cleanse(key->data(), key->size());
+    key->clear();
+    if (!device_ || blob.empty() || blob.size() > kMaxBlob) {
+        error_ = km::ErrorCode::INVALID_ARGUMENT;
+        return false;
+    }
+    SecretBytes input{{blob.begin(), blob.end()}}, output;
+    if (!accepted(device_->convertStorageKeyToEphemeral(input.bytes, &output.bytes))) return false;
+    if (output.bytes.empty() || output.bytes.size() > kMaxKey) {
+        error_ = km::ErrorCode::INVALID_ARGUMENT;
+        return false;
+    }
+    key->assign(output.bytes.begin(), output.bytes.end());
+    return true;
+}
