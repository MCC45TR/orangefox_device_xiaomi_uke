+static bool readMetadataKeyFile(int directory, const char* name, size_t maximum,
+                                std::string* bytes) {
+    android::base::unique_fd fd(openat(directory, name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK));
+    struct stat info{};
+    struct statvfs filesystem{};
+    if (fd.get() < 0 || fstat(fd.get(), &info) != 0 || !S_ISREG(info.st_mode) ||
+        info.st_uid != 0 || info.st_nlink != 1 || info.st_size <= 0 ||
+        static_cast<uint64_t>(info.st_size) > maximum || fstatvfs(fd.get(), &filesystem) != 0 ||
+        (filesystem.f_flag & ST_RDONLY) == 0) return false;
+    bytes->resize(static_cast<size_t>(info.st_size));
+    size_t done = 0;
+    unsigned interruptions = 0;
+    while (done < bytes->size()) {
+        const auto count = pread(fd.get(), bytes->data() + done, bytes->size() - done, done);
+        if (count < 0 && errno == EINTR) {
+            if (++interruptions > 8) return false;
+            continue;
+        }
+        if (count <= 0) return false;
+        done += static_cast<size_t>(count);
+    }
+    struct stat after{};
+    return fstat(fd.get(), &after) == 0 && after.st_dev == info.st_dev &&
+           after.st_ino == info.st_ino && after.st_size == info.st_size &&
+           after.st_mtim.tv_sec == info.st_mtim.tv_sec && after.st_mtim.tv_nsec == info.st_mtim.tv_nsec &&
+           after.st_ctim.tv_sec == info.st_ctim.tv_sec && after.st_ctim.tv_nsec == info.st_ctim.tv_nsec;
+}
