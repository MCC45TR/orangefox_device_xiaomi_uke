--- a/gui/pages.cpp
+++ b/gui/pages.cpp
@@ -210,7 +210,12 @@
 {
 	string value = LoadAttrString(element, attrname);
 	// resolve variables
-	DataManager::GetValue(value, value);
+	const string variable = value.size() > 2 && value.front() == '%' && value.back() == '%'
+		? value.substr(1, value.size() - 2) : value;
+	// Geometry constants (e.g. center_y) are immutable in DataManager. Resolve
+	// only the explicit viewport names at read time, without changing that store.
+	if (!ure_gui_variable(variable, value))
+		DataManager::GetValue(value, value);
 	return value.empty() ? defaultvalue : atoi(value.c_str());
 }
 
