@@ -97,6 +97,32 @@
 
 var providerRegistry []*providerKey
 
+type providerValue struct {
+	id          int
+	value       any
+	initialHash uint64
+}
+
+func (m *moduleInfo) providerIndex(id int) (int, bool) {
+	return slices.BinarySearchFunc(m.providers, id, func(p providerValue, id int) int {
+		return cmp.Compare(p.id, id)
+	})
+}
+
+// providerInitialValueHashes preserves the legacy cache-input layout without
+// retaining a full registry-sized hash array on every module. This allocation is
+// needed only when an incremental module computes its dependency cache key.
+func (m *moduleInfo) providerInitialValueHashes() []uint64 {
+	if len(m.providers) == 0 {
+		return nil
+	}
+	hashes := make([]uint64, len(providerRegistry))
+	for _, p := range m.providers {
+		hashes[p.id] = p.initialHash
+	}
+	return hashes
+}
