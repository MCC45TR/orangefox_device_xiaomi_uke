 // reboot: Reboot the system. Return -1 on error, no return on success
 int TWFunc::tw_reboot(RebootCommand command)
 {
 	ure::LegacyLifecycleGuard lifecycle("reboot", nullptr, true);
 	if (!ure_legacy_lifecycle_guard(lifecycle)) return -1;
+	const auto dualboot = ure::dualboot_quarantine_state();
+	if (dualboot != ure::DualbootQuarantineState::Clear) {
+		// The writer has already synchronized its bounded views and durable
+		// journal. Old partition nodes must never reach normal log, settings,
+		// deactivation, script or mount callbacks after a GPT change.
+		if (command != rb_recovery ||
+			(dualboot != ure::DualbootQuarantineState::Committed &&
+			 dualboot != ure::DualbootQuarantineState::GptRestored)) return -1;
+		sync();
+		return property_set(ANDROID_RB_PROPERTY, "reboot,recovery");
+	}
 	DataManager::Flush();
 	Update_Log_File();
 
