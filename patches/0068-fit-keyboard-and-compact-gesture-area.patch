+void GUIKeyboard::FitToWidth(int width)
+{
+	if (width <= 0) return;
+	// Scale boundaries once, so drawing, highlights and hit tests share exact edges.
+	for (auto& layout : layouts) {
+		for (int row = 0; row < MAX_KEYBOARD_ROWS && layout.row_end_y[row] > 0; ++row) {
+			auto& keys = layout.keys[row];
+			int count = 0;
+			while (count < MAX_KEYBOARD_KEYS && keys[count].end_x > 0) ++count;
+			if (count == 0) continue;
+			const int original_width = keys[count - 1].end_x;
+			for (int col = 0; col < count; ++col)
+				keys[col].end_x = static_cast<std::int64_t>(keys[col].end_x) * width / original_width;
+		}
+	}
+}
