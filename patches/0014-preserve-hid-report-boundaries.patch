 #define LONG(x) ((x)/BITS_PER_LONG)
 #define test_bit(bit, array)	((array[LONG(bit)] >> OFF(bit)) & 1)
 
+static bool has_touch_axes(int fd)
+{
+    unsigned long axes[NBITS(ABS_MAX + 1)] = {};
+    if (ioctl(fd, EVIOCGBIT(EV_ABS, sizeof(axes)), axes) < 0)
+        return false;
+    return (test_bit(ABS_X, axes) && test_bit(ABS_Y, axes)) ||
+           (test_bit(ABS_MT_POSITION_X, axes) && test_bit(ABS_MT_POSITION_Y, axes));
+}
+
