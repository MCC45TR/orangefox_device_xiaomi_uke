+int twrpTruetype::utf8_to_unicode(const char* pIn, const char* end, unsigned int *pOut) {
+	if (!pOut)
+		return 0;
+	*pOut = 0xfffd;
+	if (!pIn || !end || pIn >= end)
+		return 0;
+	const auto first = static_cast<unsigned char>(*pIn);
+	if (first < 0x80) {
+		*pOut = first;
+		return 1;
+	}
+	// Malformed display input consumes one original byte, without altering
+	// filename bytes subsequently used for filesystem operations.
+	const int length = first >= 0xc2 && first <= 0xdf ? 2 :
+		first >= 0xe0 && first <= 0xef ? 3 :
+		first >= 0xf0 && first <= 0xf4 ? 4 : 0;
+	if (!length || end - pIn < length)
+		return 1;
+	unsigned int scalar = first & (0x7fU >> length);
+	for (int i = 1; i < length; ++i) {
+		const auto next = static_cast<unsigned char>(pIn[i]);
+		if ((next & 0xc0) != 0x80)
+			return 1;
+		scalar = (scalar << 6) | (next & 0x3f);
+	}
+	if ((length == 2 && scalar < 0x80) ||
+		(length == 3 && scalar < 0x800) ||
+		(length == 4 && scalar < 0x10000) ||
+		(scalar >= 0xd800 && scalar <= 0xdfff) || scalar > 0x10ffff)
+		return 1;
+	*pOut = scalar;
+	return length;
