+static std::string InputCharacter(int key)
+{
+	if (key < 32 || key == 127 || key > 0x10ffff || (key >= 0xd800 && key <= 0xdfff)) return {};
+	if (key < 0x80) return std::string(1, static_cast<char>(key));
+	std::string text;
+	if (key < 0x800) text += static_cast<char>(0xc0 | (key >> 6));
+	else {
+		if (key >= 0x10000) { text += static_cast<char>(0xf0 | (key >> 18)); text += static_cast<char>(0x80 | ((key >> 12) & 0x3f)); }
+		else text += static_cast<char>(0xe0 | (key >> 12));
+		text += static_cast<char>(0x80 | ((key >> 6) & 0x3f));
+	}
+	text += static_cast<char>(0x80 | (key & 0x3f));
+	return text;
+}
+
+static std::size_t PreviousInputCharacter(const std::string& text, std::size_t end)
+{
+	if (end > text.size()) end = text.size();
+	if (!end) return 0;
+	--end;
+	while (end && (static_cast<unsigned char>(text[end]) & 0xc0) == 0x80) --end;
+	return end;
+}
