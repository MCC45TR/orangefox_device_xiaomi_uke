+// Must be called under Lock. The raw text is bounded before any string copy.
+struct Layout { int width = 0; int bytes = 0; bool valid = true; };
+Layout layout(TrueTypeFont* font, const char* input, size_t length, int limit) {
+	Layout result;
+	const char* end = input + length;
+	int previous = 0;
+	size_t characters = 0;
+	while (input < end && *input) {
+		if (++characters > TEXT_CHARACTERS) { result.valid = false; break; }
+		unsigned int scalar = 0;
+		const int consumed = twrpTruetype::utf8_to_unicode(input, end, &scalar);
+		const int index = FT_Get_Char_Index(font->face, scalar);
+		// Width measurement never allocates a text raster or rendered glyph.
+		if (FT_Load_Glyph(font->face, index, FT_LOAD_NO_BITMAP)) { result.valid = false; break; }
+		int64_t advance = font->face->glyph->advance.x >> 6;
+		if (FT_HAS_KERNING(font->face) && previous && index) {
+			FT_Vector delta{};
+			if (FT_Get_Kerning(font->face, previous, index, FT_KERNING_DEFAULT, &delta)) { result.valid = false; break; }
+			advance += delta.x >> 6;
+		}
+		const int64_t width = std::max<int64_t>(0, result.width + advance);
+		if (width > TEXT_WIDTH) { result.valid = false; break; }
+		if (width > limit) break;
+		result.width = static_cast<int>(width);
+		result.bytes += consumed;
+		input += consumed;
+		previous = index;
+	}
+	return result;
+}
+}
