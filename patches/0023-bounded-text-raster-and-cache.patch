+TrueTypeCacheEntry* twrpTruetype::gr_ttf_glyph_cache_get(TrueTypeFont* font, int index) {
+	if (auto* entry = gr_ttf_glyph_cache_peek(font, index)) return entry;
+	if (FT_Load_Glyph(font->face, index, FT_LOAD_NO_BITMAP)) return nullptr;
+	const auto& metrics = font->face->glyph->metrics;
+	if (metrics.width < 0 || metrics.height < 0 || metrics.width > FONT_HEIGHT * 64 || metrics.height > FONT_HEIGHT * 64) return nullptr;
+	FT_BBox box{};
+	FT_Outline_Get_CBox(&font->face->glyph->outline, &box);
+	if (box.xMin < -TEXT_WIDTH*64L || box.xMax > TEXT_WIDTH*64L || box.yMin < -TEXT_WIDTH*64L || box.yMax > TEXT_WIDTH*64L) return nullptr;
+	const int64_t width = ((int64_t(box.xMax)+63) / 64) - (int64_t(box.xMin) >> 6);
+	const int64_t height = ((int64_t(box.yMax)+63) / 64) - (int64_t(box.yMin) >> 6);
+	if (width < 0 || height < 0 || width > FONT_HEIGHT || height > FONT_HEIGHT ||
+		(height && width > static_cast<int64_t>(RASTER_BYTES) / height)) return nullptr;
+	if (FT_Render_Glyph(font->face->glyph, FT_RENDER_MODE_NORMAL)) return nullptr;
+	FT_Glyph raw = nullptr;
+	if (FT_Get_Glyph(font->face->glyph, &raw)) return nullptr;
+	auto* glyph = reinterpret_cast<FT_BitmapGlyph>(raw);
+	const int64_t pitch = glyph->bitmap.pitch;
+	const uint64_t stride = static_cast<uint64_t>(pitch < 0 ? -pitch : pitch);
+	const uint64_t bytes = stride * glyph->bitmap.rows;
+	if (glyph->bitmap.pixel_mode != FT_PIXEL_MODE_GRAY || glyph->bitmap.width > FONT_HEIGHT ||
+		glyph->bitmap.rows > FONT_HEIGHT || bytes > RASTER_BYTES) { FT_Done_Glyph(raw); return nullptr; }
+	const size_t owned = static_cast<size_t>(bytes) + sizeof(TrueTypeCacheEntry) + 256;
