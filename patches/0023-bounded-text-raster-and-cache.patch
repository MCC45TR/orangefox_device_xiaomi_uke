+void* twrpTruetype::gr_ttf_loadFont(const char* filename, int size, int dpi) {
+	Lock lock;
+	if (!filename || strnlen(filename, 4097) > 4096 || size < 1 || size > 1024 ||
+		dpi < 1 || dpi > 1200 || int64_t(size) * dpi > 288 * 1024) {
+		text_failure(); return nullptr;
+	}
+	try {
+		const int fd = open(filename, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+		if (fd < 0) return nullptr;
+		struct OpenSource { int fd; ~OpenSource() { close(fd); } } open_source{fd};
+		struct stat statbuf{};
+		if (fstat(fd, &statbuf) || !S_ISREG(statbuf.st_mode) || statbuf.st_size <= 0 ||
+			uint64_t(statbuf.st_size) > FONT_FILE_BYTES) { text_failure(); return nullptr; }
+		TrueTypeFontKey key{size, dpi, filename, source_identity(statbuf)};
+		auto existing = font_data.fonts.find(key);
+		if (existing != font_data.fonts.end()) {
+			if (existing->second->refcount == INT_MAX) { text_failure(); return nullptr; }
+			++existing->second->refcount;
+			return existing->second;
+		}
+		if (font_data.fonts.size() >= FONT_COUNT) { text_failure(); return nullptr; }
+		if (!font_data.ft_library) {
+			if (FT_New_Library(&parser_memory, &font_data.ft_library)) return nullptr;
+			FT_Add_Default_Modules(font_data.ft_library);
+			FT_Set_Default_Properties(font_data.ft_library);
+		}
+		std::string source_key = key.path;
+		for (const auto field : key.identity) source_key += ":"+std::to_string(field);
+		auto source = shared_faces.find(source_key);
+		if (source == shared_faces.end()) {
+			if (uint64_t(statbuf.st_size) > FONT_SOURCE_BYTES - font_source_bytes) { text_failure(); return nullptr; }
+			SharedFace face;
+			face.length = static_cast<size_t>(statbuf.st_size);
+			face.bytes.reset(new (std::nothrow) unsigned char[face.length]);
+			if (!face.bytes) { text_failure(); return nullptr; }
+			size_t offset = 0;
+			while (offset < face.length) {
+				const auto count = pread(fd, face.bytes.get()+offset, face.length-offset, offset);
+				if (count < 0 && errno == EINTR) continue;
+				if (count <= 0) return nullptr;
+				offset += static_cast<size_t>(count);
+			}
+			struct stat recheck{};
+			if (fstat(fd, &recheck) || source_identity(recheck) != key.identity) return nullptr;
+			if (FT_New_Memory_Face(font_data.ft_library, face.bytes.get(), face.length, 0, &face.face)) return nullptr;
+			if (!FT_IS_SCALABLE(face.face)) return nullptr;
+			source = shared_faces.emplace(source_key, std::move(face)).first;
+			font_source_bytes += source->second.length;
+		}
+		auto& face = source->second;
+		TrueTypeFont* font = nullptr;
+		try {
+			font = new TrueTypeFont{};
+			font->key = new TrueTypeFontKey(key);
+			font->type = FONT_TYPE_TTF;
+			font->size = size; font->dpi = dpi; font->refcount = 1;
+			font->face = face.face; font->max_height = -1; font->base = -1;
+			if (FT_New_Size(font->face, &font->ft_size) || FT_Activate_Size(font->ft_size) ||
+				FT_Set_Char_Size(font->face, 0, size * 16, dpi, dpi)) throw std::bad_alloc();
+			font_data.fonts.emplace(key, font);
+			++face.users;
+			return font;
+		} catch (...) {
+			if (font) { if (font->ft_size) FT_Done_Size(font->ft_size); delete font->key; delete font; }
+			if (!face.users) { font_source_bytes -= face.length; shared_faces.erase(source); }
+			throw;
+		}
+	} catch (const std::bad_alloc&) { text_failure(); return nullptr; }
+}
+
+void* twrpTruetype::gr_ttf_scaleFont(void* handle, int max_width, int measured_width) {
+	// Copy the key while owning its font; never keep a path pointer across unlock.
+	std::string path;
+	int size = 0, dpi = 0;
+	{
+		Lock lock;
+		auto* font = registered_font(handle);
+		if (!font || max_width <= 0 || measured_width <= 0) return nullptr;
+		try { path = font->key->path; } catch (const std::bad_alloc&) { text_failure(); return nullptr; }
+		const int64_t requested = std::max<int64_t>(1, int64_t(font->size) * max_width / measured_width - 1);
+		if (requested > 1024 || requested * font->dpi > 288 * 1024) { text_failure(); return nullptr; }
+		size = static_cast<int>(requested);
+		dpi = font->dpi;
+	}
+	return gr_ttf_loadFont(path.c_str(), size, dpi);
+}
+
+void twrpTruetype::gr_ttf_freeStringCache(void* key, void* value, void*) {
+	delete static_cast<StringCacheKey*>(key);
+	auto* entry = static_cast<StringCacheEntry*>(value);
+	cache_bytes -= entry->owned_bytes;
+	free(entry->surface.data);
+	delete entry;
+}
+
+void twrpTruetype::gr_ttf_freeFont(void* handle) {
+	Lock lock;
+	auto* font = registered_font(handle);
+	if (!font || --font->refcount) return;
+	while (!font->string_cache.empty()) erase_string(font);
+	while (!font->glyph_cache.empty()) erase_glyph(font);
+	FT_Done_Size(font->ft_size);
+	auto source = std::find_if(shared_faces.begin(), shared_faces.end(), [font](const auto& source) { return source.second.face == font->face; });
+	if (source != shared_faces.end() && !--source->second.users) {
+		font_source_bytes -= source->second.length;
+		shared_faces.erase(source);
+	}
+	font_data.fonts.erase(*font->key);
+	delete font->key;
+	delete font;
+}
