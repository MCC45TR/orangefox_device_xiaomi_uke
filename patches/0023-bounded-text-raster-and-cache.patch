+	else while (font->glyph_cache.size() >= GLYPH_ENTRIES) erase_glyph(font);
+	while (bytes > CACHE_BYTES - cache_bytes && !font->string_cache.empty()) erase_string(font);
+	while (bytes > CACHE_BYTES - cache_bytes && !font->glyph_cache.empty()) erase_glyph(font);
