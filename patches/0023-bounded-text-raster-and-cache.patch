+	const int64_t top = int64_t(offY) + base - glyph->top;
+	const int64_t x0 = std::max<int64_t>(0, left), y0 = std::max<int64_t>(0, top);
+	const int64_t x1 = std::min<int64_t>(dest->width, left + glyph->bitmap.width);
