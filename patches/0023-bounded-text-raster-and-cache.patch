+int twrpTruetype::gr_ttf_copy_glyph_to_surface(GGLSurface* dest, FT_BitmapGlyph glyph, int offX, int offY, int base) {
+	if (!dest || !glyph || !dest->data || !glyph->bitmap.buffer || dest->stride < 0 ||
