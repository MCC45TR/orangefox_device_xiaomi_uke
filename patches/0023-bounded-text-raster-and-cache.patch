+TrueTypeCacheEntry* twrpTruetype::gr_ttf_glyph_cache_peek(TrueTypeFont* font, int index) {
+	auto found = font->glyph_cache.find(index);
+	return found == font->glyph_cache.end() ? nullptr : found->second;
+}
