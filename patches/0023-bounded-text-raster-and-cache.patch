+size_t refused_parser_allocations = 0;
+struct alignas(std::max_align_t) ParserAllocation { size_t bytes; };
+void* parser_alloc(FT_Memory, long requested) {
+	if (requested <= 0) return nullptr;
+	const auto bytes = static_cast<size_t>(requested);
+	if (bytes > PARSER_ALLOCATION || bytes > PARSER_BYTES - parser_bytes) {
+		++refused_parser_allocations; return nullptr;
+	}
+	auto* allocation = static_cast<ParserAllocation*>(malloc(sizeof(ParserAllocation)+bytes));
+	if (!allocation) return nullptr;
+	allocation->bytes = bytes; parser_bytes += bytes;
+	return allocation+1;
+}
+void parser_free(FT_Memory, void* block) {
+	if (!block) return;
+	auto* allocation = static_cast<ParserAllocation*>(block)-1;
+	parser_bytes -= allocation->bytes;
+	free(allocation);
+}
+void* parser_realloc(FT_Memory memory, long, long requested, void* block) {
+	if (requested <= 0) { parser_free(memory, block); return nullptr; }
+	void* replacement = parser_alloc(memory, requested);
+	if (!replacement) return nullptr;
+	if (block) {
+		const auto* allocation = static_cast<ParserAllocation*>(block)-1;
+		memcpy(replacement, block, std::min(static_cast<size_t>(requested), allocation->bytes));
+		parser_free(memory, block);
+	}
+	return replacement;
+}
+FT_MemoryRec_ parser_memory{nullptr, parser_alloc, parser_free, parser_realloc};
