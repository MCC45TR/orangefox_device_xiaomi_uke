+StringCacheEntry* twrpTruetype::gr_ttf_string_cache_get(TrueTypeFont* font, const std::string& text, int max_width) {
+	if (text.size() > TEXT_BYTES) return nullptr;
+	if (auto* found = gr_ttf_string_cache_peek(font, text, max_width)) return found;
+	std::unique_ptr<StringCacheEntry> entry(new (std::nothrow) StringCacheEntry{});
+	if (!entry) return nullptr;
+	entry->rendered_bytes = gr_ttf_render_text(font, &entry->surface, text, max_width);
+	if (entry->rendered_bytes < 0) return nullptr;
+	Pixels pixels(entry->surface.data);
+	const size_t bytes = size_t(entry->surface.width) * entry->surface.height;
+	// Include map/key storage and allocator headroom, not only raster pixels.
+	const size_t owned = bytes + 4 * (text.size()+1) + sizeof(StringCacheEntry) + 512;
+	if (!make_room(font, owned, true)) return nullptr;
+	entry->owned_bytes = owned;
+	try { font->string_cache.emplace(StringCacheKey{max_width, text}, entry.get()); }
+	catch (const std::bad_alloc&) { return nullptr; }
+	cache_bytes += owned;
+	pixels.release();
+	return entry.release();
+}
