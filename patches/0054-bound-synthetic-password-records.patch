+++ b/ure-fbe-parser.hpp
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cerrno>
+#include <cstdint>
+#include <fcntl.h>
+#include <string>
+#include <string_view>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <utility>
+
+namespace ure_fbe {
+
+// Conservative recovery admission limits, not new Android record formats.
+constexpr size_t kMaxStateBytes = 64 * 1024;
+constexpr size_t kMaxSaltBytes = 1024;
+constexpr size_t kMaxHandleBytes = 16 * 1024;
+constexpr size_t kMaxCredentialBytes = 4096;
+constexpr uint64_t kMaxScryptMemory = 32 * 1024 * 1024;
+constexpr uint64_t kMaxScryptWork = 1024 * 1024; // N * r * p, not wall time.
+constexpr size_t kGcmIvBytes = 12;
+constexpr size_t kGcmTagBytes = 16;
+
+inline bool ReadStateFile(const std::string& path, std::string* output, size_t limit) {
+    if (!output || limit > kMaxStateBytes) return false;
+    output->clear();
+    struct ScopedFd {
+        int value;
+        ~ScopedFd() { if (value >= 0) close(value); }
+    } fd{open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK)};
+    if (fd.value < 0) return false;
+    struct stat st{};
+    if (fstat(fd.value, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < 0 ||
+        static_cast<uint64_t>(st.st_size) > limit) return false;
+    std::string data;
+    data.reserve(static_cast<size_t>(st.st_size));
+    char buffer[4096];
+    for (;;) {
+        const ssize_t count = read(fd.value, buffer, sizeof(buffer));
+        if (count < 0) {
+            if (errno == EINTR) continue;
+            return false;
+        }
+        if (count == 0) break;
+        if (static_cast<size_t>(count) > limit - data.size()) return false;
+        data.append(buffer, static_cast<size_t>(count));
+    }
+    *output = std::move(data);
+    return true;
+}
+
+inline bool ReadBe32(std::string_view data, size_t* offset, uint32_t* value) {
+    if (!offset || !value || *offset > data.size() || data.size() - *offset < 4) return false;
+    uint32_t result = 0;
+    for (unsigned i = 0; i < 4; ++i)
+        result = (result << 8) | static_cast<unsigned char>(data[(*offset)++]);
+    *value = result;
+    return true;
+}
+
+inline int32_t Signed32(uint32_t value) {
+    if (value <= static_cast<uint32_t>(INT32_MAX)) return static_cast<int32_t>(value);
+    return -1 - static_cast<int32_t>(UINT32_MAX - value);
+}
+
+struct ScryptParameters {
+    uint64_t n = 0;
+    uint32_t r = 0, p = 0;
+};
+
+inline bool CheckScrypt(unsigned logN, unsigned logR, unsigned logP, ScryptParameters* output) {
+    if (!output || logN == 0 || logN >= 63 || logR >= 31 || logP >= 31) return false;
+    const uint64_t n = uint64_t{1} << logN;
+    const uint64_t r = uint64_t{1} << logR;
+    const uint64_t p = uint64_t{1} << logP;
+    // libscrypt needs V=128*r*N, B=128*r*p, XY=256*r (+64 for SSE).
+    if (r > (kMaxScryptMemory - 64) / 256) return false;
+    const uint64_t fixed = 256 * r + 64, block = 128 * r;
+    if (n > (kMaxScryptMemory - fixed) / block) return false;
+    const uint64_t remaining = kMaxScryptMemory - fixed - block * n;
+    if (p > remaining / block || n > kMaxScryptWork / r / p) return false;
+    *output = {n, static_cast<uint32_t>(r), static_cast<uint32_t>(p)};
+    return true;
+}
+
+struct PasswordData {
+    int32_t type = 0;
+    unsigned char logN = 0, logR = 0, logP = 0;
+    std::string_view salt, handle;
+};
+
+inline bool ParsePasswordData(std::string_view data, PasswordData* output) {
+    if (!output || data.size() < 15 || data.size() > kMaxStateBytes) return false;
+    PasswordData result;
+    size_t offset = 0;
+    uint32_t value;
+    if (!ReadBe32(data, &offset, &value)) return false;
+    result.type = Signed32(value);
+    if (result.type != -1 && (result.type < 1 || result.type > 4)) return false;
+    result.logN = static_cast<unsigned char>(data[offset++]);
+    result.logR = static_cast<unsigned char>(data[offset++]);
+    result.logP = static_cast<unsigned char>(data[offset++]);
+    ScryptParameters cost;
+    if (!CheckScrypt(result.logN, result.logR, result.logP, &cost)) return false;
+    if (!ReadBe32(data, &offset, &value) || value == 0 || value > kMaxSaltBytes ||
+        value > data.size() - offset) return false;
+    result.salt = data.substr(offset, value);
+    offset += value;
+    if (!ReadBe32(data, &offset, &value) || value > kMaxHandleBytes ||
+        value > data.size() - offset) return false;
+    result.handle = data.substr(offset, value);
+    offset += value;
+    // The pinned Android 16 writer adds one big-endian int32 PIN length.
+    // Older records have no tail. Unknown extensions are not guessed.
+    if (data.size() - offset == 4) {
+        if (!ReadBe32(data, &offset, &value) || Signed32(value) < -1) return false;
+    }
+    if (offset != data.size()) return false;
+    *output = result;
+    return true;
+}
+
+inline bool ParseWeaver(std::string_view data, int* slot) {
+    if (!slot || data.size() != 5 || static_cast<unsigned char>(data[0]) != 1) return false;
+    size_t offset = 1;
+    uint32_t value;
+    if (!ReadBe32(data, &offset, &value) || value > static_cast<uint32_t>(INT32_MAX)) return false;
+    *slot = static_cast<int>(value);
+    return true;
+}
+
+struct GcmPayload {
+    std::string_view iv, ciphertext, tag;
+};
+
+inline bool ParseGcmPayload(std::string_view data, GcmPayload* output) {
+    if (!output || data.size() < kGcmIvBytes + kGcmTagBytes || data.size() > kMaxStateBytes) return false;
+    *output = {data.substr(0, kGcmIvBytes),
+               data.substr(kGcmIvBytes, data.size() - kGcmIvBytes - kGcmTagBytes),
+               data.substr(data.size() - kGcmTagBytes)};
+    return true;
+}
+
+struct Spblob {
+    unsigned char version = 0;
+    GcmPayload content;
+};
+
+inline bool ParseSpblob(std::string_view data, Spblob* output) {
+    if (!output || data.size() < 2 + kGcmIvBytes + kGcmTagBytes || data.size() > kMaxStateBytes) return false;
+    const unsigned char version = static_cast<unsigned char>(data[0]);
+    if (version < 1 || version > 3 || data[1] != 0) return false;
+    GcmPayload content;
+    if (!ParseGcmPayload(data.substr(2), &content)) return false;
+    *output = {version, content};
+    return true;
+}
+
+} // namespace ure_fbe
