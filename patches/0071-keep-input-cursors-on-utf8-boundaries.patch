+static std::size_t NextInputCharacter(const std::string& text, std::size_t begin)
+{
+	if (begin >= text.size()) return text.size();
+	++begin;
+	while (begin < text.size() && (static_cast<unsigned char>(text[begin]) & 0xc0) == 0x80) ++begin;
+	return begin;
