+#ifdef TW_UKE_NATIVE_THEME
+int GUIAction::uretheme(std::string arg)
+{
+    (void)arg;
+    if (DataManager::GetIntValue("update_fonts") || DataManager::GetIntValue("update_navbar")) {
+        gui_err("Theme font/navigation changes require an accepted settings storage path.");
+        return 1;
+    }
+    ure::theme::Overlay overlay;
+    if (!DataManager::GetIntValue("remove_theme") && !ure::theme::prepare(
+            DataManager::GetStrValue("theme_style_tmp"), DataManager::GetStrValue("theme_accent_tmp"),
+            DataManager::GetStrValue("theme_accent_light_tmp"), DataManager::GetStrValue("theme_accent_dark_tmp"),
+            DataManager::GetStrValue("theme_style_act_tmp") == "Default", overlay)) {
+        gui_err("Unable to apply the selected packaged theme.");
+        return 1;
+    }
+    ure::theme::commit(std::move(overlay));
+    DataManager::SetValue("needs_repack", 0);
+    DataManager::SetValue("remove_theme", 0);
+    PageManager::RequestUreThemeReload();
+    return 0;
+}
+#endif
