+	static std::mutex lock;
+	static bool fixed = false;
+	const std::lock_guard<std::mutex> guard(lock);
+	if (fixed) return;
+	const auto state = ure::clock::apply();
+	fixed = state == ure::clock::State::observed || state == ure::clock::State::applied;
+	DataManager::SetValue("ure_clock_available", fixed ? "1" : "0");
+}
