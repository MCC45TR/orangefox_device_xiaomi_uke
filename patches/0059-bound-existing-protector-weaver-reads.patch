@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: Apache-2.0
+// Bounds for recovery's existing-protector Weaver read. This does not admit
+// credential attempts, start services, or establish read-only TEE behavior.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace ure_weaver {
+constexpr uint32_t kMaxSlots = 4096;
+constexpr uint32_t kMaxKeyBytes = 64;  // PersonalizedHashBinary returns SHA-512.
+constexpr uint32_t kMaxValueBytes = 4096;
+
+inline bool Config(int64_t slots, int64_t key_bytes, int64_t value_bytes) {
+    return slots > 0 && slots <= kMaxSlots && key_bytes > 0 &&
+           key_bytes <= kMaxKeyBytes && value_bytes > 0 && value_bytes <= kMaxValueBytes;
+}
+
+inline bool Request(uint32_t slot, uint32_t slots, uint32_t key_bytes,
+                    size_t available_bytes, const void* key) {
+    return key != nullptr && slots > 0 && slots <= kMaxSlots && slot < slots &&
+           key_bytes > 0 && key_bytes <= kMaxKeyBytes && available_bytes >= key_bytes;
+}
+
+inline bool Timeout(int64_t milliseconds, bool aidl, uint64_t* output) {
+    if (output == nullptr || milliseconds < 0 ||
+        milliseconds > std::numeric_limits<uint32_t>::max() ||
+        (aidl && milliseconds >= std::numeric_limits<int32_t>::max())) return false;
+    *output = static_cast<uint64_t>(milliseconds);
+    return true;
+}
+}  // namespace ure_weaver
