# SPDX-License-Identifier: BSD-3-Clause
# Initial read-only Uke recovery map. Write/format flags require device acceptance.

system          /system          erofs   ro   wait,slotselect,avb=vbmeta_system,logical
system_ext      /system_ext      erofs   ro   wait,slotselect,avb=vbmeta_system,logical
product         /product         erofs   ro   wait,slotselect,avb=vbmeta_system,logical
vendor          /vendor          erofs   ro   wait,slotselect,avb=vbmeta,logical
vendor          /vendor          ext4    ro,noload,nosuid,nodev   wait,slotselect,avb=vbmeta,logical
vendor_dlkm     /vendor_dlkm     erofs   ro   wait,slotselect,avb=vbmeta,logical
system_dlkm     /system_dlkm     erofs   ro   wait,slotselect,avb=vbmeta,logical
odm             /odm             erofs   ro   wait,slotselect,avb=vbmeta,logical
mi_ext          /mi_ext          erofs   ro   wait,slotselect,avb=vbmeta,logical,nofail

/dev/block/bootdevice/by-name/metadata  /metadata  f2fs  ro,norecovery,nosuid,nodev  wait,backup=1,wipeingui=1
/dev/block/bootdevice/by-name/userdata  /data      f2fs  ro,norecovery,nosuid,nodev  wait,backup=1,wipeingui=1
/misc emmc /dev/block/bootdevice/by-name/misc flags=display="Bootloader Message";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/dev/block/bootdevice/by-name/persist   /persist   ext4  ro,noload,nosuid,nodev  wait,backup=1,wipeingui=0,canbewiped=0

# Explicit slots avoid silently backing up the inactive slot under an ambiguous
# alias. These are backup selections, never factory-reset or image-flash targets.
/boot_a emmc /dev/block/bootdevice/by-name/boot_a flags=display="Boot A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/boot_b emmc /dev/block/bootdevice/by-name/boot_b flags=display="Boot B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/init_boot_a emmc /dev/block/bootdevice/by-name/init_boot_a flags=display="Init Boot A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/init_boot_b emmc /dev/block/bootdevice/by-name/init_boot_b flags=display="Init Boot B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vendor_boot_a emmc /dev/block/bootdevice/by-name/vendor_boot_a flags=display="Vendor Boot A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vendor_boot_b emmc /dev/block/bootdevice/by-name/vendor_boot_b flags=display="Vendor Boot B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/recovery_a emmc /dev/block/bootdevice/by-name/recovery_a flags=display="Recovery A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/recovery_b emmc /dev/block/bootdevice/by-name/recovery_b flags=display="Recovery B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/dtbo_a emmc /dev/block/bootdevice/by-name/dtbo_a flags=display="DTBO A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/dtbo_b emmc /dev/block/bootdevice/by-name/dtbo_b flags=display="DTBO B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vbmeta_a emmc /dev/block/bootdevice/by-name/vbmeta_a flags=display="VBMeta A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vbmeta_b emmc /dev/block/bootdevice/by-name/vbmeta_b flags=display="VBMeta B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vbmeta_system_a emmc /dev/block/bootdevice/by-name/vbmeta_system_a flags=display="VBMeta System A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/vbmeta_system_b emmc /dev/block/bootdevice/by-name/vbmeta_system_b flags=display="VBMeta System B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/frp emmc /dev/block/bootdevice/by-name/frp flags=display="FRP";backup=1;flashimg=0;canbewiped=0;wipeingui=0

# Exact images supplement the mounted metadata/persist file selections. A raw
# capture includes private keys/calibration; preserve it only in a private backup.
/metadata_image emmc /dev/block/bootdevice/by-name/metadata flags=display="Metadata Image";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/persist_image emmc /dev/block/bootdevice/by-name/persist flags=display="Persist Image";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/bluetooth_a emmc /dev/block/bootdevice/by-name/bluetooth_a flags=display="Bluetooth A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/bluetooth_b emmc /dev/block/bootdevice/by-name/bluetooth_b flags=display="Bluetooth B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/dsp_a emmc /dev/block/bootdevice/by-name/dsp_a flags=display="DSP A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/dsp_b emmc /dev/block/bootdevice/by-name/dsp_b flags=display="DSP B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/modem_a emmc /dev/block/bootdevice/by-name/modem_a flags=display="Modem A";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/modem_b emmc /dev/block/bootdevice/by-name/modem_b flags=display="Modem B";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/modemst1 emmc /dev/block/bootdevice/by-name/modemst1 flags=display="Modem State 1";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/modemst2 emmc /dev/block/bootdevice/by-name/modemst2 flags=display="Modem State 2";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/fsg emmc /dev/block/bootdevice/by-name/fsg flags=display="Radio Configuration";backup=1;flashimg=0;canbewiped=0;wipeingui=0
/fsc emmc /dev/block/bootdevice/by-name/fsc flags=display="Radio State";backup=1;flashimg=0;canbewiped=0;wipeingui=0
