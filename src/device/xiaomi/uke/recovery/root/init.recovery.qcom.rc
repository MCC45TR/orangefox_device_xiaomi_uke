#
# Uke Global OS3.0.303.0 candidate. Generic recovery init.rc owns the
# configfs gadget, FunctionFS mounts, adbd service and USB state transitions.
# The exact stock controller property must match before selecting this path.
# Run after generic on-init reset of sys.usb.configfs, before its on-fs gadget
# creation. Imported actions may be parsed before the importing init.rc body.
on early-fs && property:ro.boot.usbcontroller=a600000.dwc3
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3
    wait /sys/bus/platform/devices/a600000.ssusb/mode 2
    write /sys/bus/platform/devices/a600000.ssusb/mode peripheral
    wait /sys/class/udc/a600000.dwc3 2

# /dev is first-stage tmpfs. Keep the generic boot-device partition labels
# available through the fstab's compatibility prefix, without replacing paths.
# init's symlink() fails on an existing link; it never unlinks or follows it.
on early-fs
    mkdir /dev/block/bootdevice 0755 root root
    symlink /dev/block/by-name /dev/block/bootdevice/by-name
