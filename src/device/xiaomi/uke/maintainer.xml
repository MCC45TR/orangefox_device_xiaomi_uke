<?xml version="1.0" encoding="UTF-8"?>
<!-- Project-owned URE pages. Actions are native; paths never enter a shell. -->
<recovery>
  <variables>
    <variable name="ure_root" value="/mnt/uke-linux"/>
    <variable name="ure_file" value="etc/fstab"/>
    <variable name="ure_status" value="Experimental build; device acceptance is pending"/>
    <variable name="ure_output" value="Select an operation"/>
    <variable name="ure_find" value=""/>
    <variable name="ure_replace" value=""/>
    <variable name="ure_journal_parent" value="/tmp"/>
    <variable name="ure_journal" value=""/>
    <variable name="ure_journal_hash" value=""/>
    <variable name="ure_backup_dir" value="/mnt/uke-linux/ure-backup"/>
    <variable name="ure_backup_hash" value=""/>
    <variable name="ure_raw_kind" value="image"/>
    <variable name="ure_raw_source" value=""/>
    <variable name="ure_raw_sector" value="4096"/>
    <variable name="ure_gpt_kind" value="image"/>
    <variable name="ure_gpt_source" value=""/>
    <variable name="ure_gpt_sector" value="4096"/>
    <variable name="ure_gpt_backup_dir" value="/mnt/uke-linux/ure-gpt-backup"/>
    <variable name="ure_gpt_journal" value=""/>
    <variable name="ure_gpt_plan_hash" value=""/>
    <variable name="ure_gpt_journal_hash" value=""/>
    <variable name="ure_gpt_can_execute" value="0"/>
    <variable name="ure_gpt_can_rollback" value="0"/>
    <variable name="ure_gpt_can_resume" value="0"/>
    <variable name="ure_restore_journal" value=""/>
    <variable name="ure_restore_plan_hash" value=""/>
    <variable name="ure_restore_journal_hash" value=""/>
    <variable name="ure_restore_can_execute" value="0"/>
    <variable name="ure_restore_can_resume" value="0"/>
    <variable name="ure_restore_can_rollback" value="0"/>
    <variable name="ure_restore_can_cancel" value="0"/>
  </variables>
  <pages>
    <page name="maintainer">
      <action><action function="page">ure_home</action></action>
    </page>
    <page name="ure_home">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Uke Recovery Environment</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <text style="caption"><placement x="%gl_text_x%" y="0"/><text>OS discovery uses an already mounted root. Review capability limits.</text></text>
        <listbox style="group_list">
          <placement x="0" y="80" w="%screen_w%" h="1200"/>
          <listitem name="Capabilities and runtime dependencies"><icon res="overview"/><action function="uremanager">capabilities</action><action function="page">ure_output</action></listitem>
          <listitem name="Storage Graph and mount inventory"><icon res="partitions"/><action function="uremanager">storage</action><action function="page">ure_output</action></listitem>
          <listitem name="Recovery diagnostics"><icon res="wrench"/><action function="uremanager">diagnose</action><action function="page">ure_output</action></listitem>
          <listitem name="Export a scrubbed JSON report"><icon res="overview"/><action function="uremanager">report</action><action function="page">ure_output</action></listitem>
          <listitem name="Select OS root and editor file"><icon res="mount_list"/><action function="page">ure_select</action></listitem>
          <listitem name="Linux distribution, kernels and boot entries"><icon res="overview"/><action function="uremanager">linux</action><action function="page">ure_output</action></listitem>
          <listitem name="Windows installation discovery"><icon res="overview"/><action function="uremanager">windows</action><action function="page">ure_output</action></listitem>
          <listitem name="Files and metadata"><icon res="overview"/><action function="uremanager">files</action><action function="page">ure_output</action></listitem>
          <listitem name="Boot target consistency"><icon res="restart"/><action function="uremanager">boot</action><action function="page">ure_output</action></listitem>
          <listitem name="Native text editor"><icon res="wrench"/><action function="uremanager">load</action><action function="page">ure_editor</action></listitem>
          <listitem name="Interrupted transactions and rollback"><icon res="wrench"/><action function="page">ure_journals</action></listitem>
          <listitem name="File backup"><icon res="overview"/><action function="page">ure_backup</action></listitem>
          <listitem name="Storage image and live partition backup"><icon res="partitions"/><action function="page">ure_raw_select</action></listitem>
          <listitem name="Raw image restore and interrupted operation recovery"><icon res="partitions"/><action function="page">ure_restore_select</action></listitem>
          <listitem name="GPT backup, image repair and journal recovery"><icon res="partitions"/><action function="page">ure_gpt_select</action></listitem>
        </listbox>
      </scroll>
      <template name="navbar"/>
      <action><touch key="back"/><action function="page">advanced</action></action>
    </page>
    <page name="ure_output">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>URE result</text></text>
      <textbox><placement x="%col1_x%" y="%ab_h%" w="%input_w%" h="%scroll_nav_h%"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
      <template name="navbar"/>
      <action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_select">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>OS root and relative file</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>Already mounted root directory</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_root%</text><data name="ure_root"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Relative file path; symlinks are refused</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_file%</text><data name="ure_file"/><restrict minlen="1" maxlen="4096"/></input>
      <template name="gestures_key"/>
      <action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_editor">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Editor: line %ure_line_number%</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>%ure_status%</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_line%</text><data name="ure_line"/><restrict maxlen="8192"/><action function="uremanager">apply-line</action></input>
      <listbox style="group_list"><placement x="0" y="%row4_1_y%" w="%screen_w%" h="%files_np_w%"/>
        <listitem name="Apply this line"><action function="uremanager">apply-line</action></listitem>
        <listitem name="Previous line"><action function="uremanager">previous</action></listitem>
        <listitem name="Next line"><action function="uremanager">next</action></listitem>
        <listitem name="More editor actions"><action function="page">ure_editor_actions</action></listitem>
      </listbox>
      <template name="gestures_key"/>
      <action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_editor_actions">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Editor actions</text></text>
      <listbox style="group_list"><placement x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%"/>
        <listitem name="Undo"><action function="uremanager">undo</action><action function="page">ure_editor</action></listitem>
        <listitem name="Redo"><action function="uremanager">redo</action><action function="page">ure_editor</action></listitem>
        <listitem name="Insert a line"><action function="uremanager">insert</action><action function="page">ure_editor</action></listitem>
        <listitem name="Delete this line"><action function="uremanager">delete</action><action function="page">ure_editor</action></listitem>
        <listitem name="Search and replace"><action function="page">ure_search</action></listitem>
        <listitem name="Preview buffer"><action function="set">ure_output=ure_preview</action><action function="page">ure_output</action></listitem>
        <listitem name="Review save plan"><action function="uremanager">plan</action><action function="page">ure_save</action></listitem>
      </listbox>
      <template name="navbar"/>
      <action><touch key="back"/><action function="page">ure_editor</action></action>
    </page>
    <page name="ure_search">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Find / replace</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_find%</text><data name="ure_find"/><restrict maxlen="4096"/><action function="uremanager">find</action></input>
      <input><placement x="%col1_x%" y="%row4_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_replace%</text><data name="ure_replace"/><restrict maxlen="4096"/><action function="uremanager">replace</action></input>
      <text style="caption"><placement x="%col1_x%" y="%row5_1_y%"/><text>Enter in first field finds; enter in second replaces all in memory.</text></text>
      <template name="gestures_key"/>
      <action><touch key="back"/><action function="page">ure_editor</action></action>
    </page>
    <page name="ure_journals">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Transaction recovery</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>Journal parent; /tmp is lost on reboot</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_journal_parent%</text><data name="ure_journal_parent"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Journal directory; select the matching OS root first</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_journal%</text><data name="ure_journal"/><restrict maxlen="4096"/></input>
      <listbox style="group_list"><placement x="0" y="%row6_1_y%" w="%screen_w%" h="400"/>
        <listitem name="Find journals"><action function="uremanager">journals</action><action function="page">ure_output</action></listitem>
        <listitem name="Inspect selected journal"><action function="uremanager">journal-inspect</action><action function="page">ure_journal_review</action></listitem>
      </listbox>
      <template name="gestures_key"/><action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_journal_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review transaction recovery</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="900"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="0" w="%screen_w%" h="500"/>
          <listitem name="Confirm reviewed plan and resume"><condition var1="ure_can_resume" var2="1"/><action function="uremanager">journal-resume</action><action function="page">ure_output</action></listitem>
          <listitem name="Cancel unchanged transaction"><condition var1="ure_can_cancel" var2="1"/><action function="uremanager">journal-cancel</action><action function="page">ure_output</action></listitem>
          <listitem name="Confirm rollback to verified original backup"><condition var1="ure_can_rollback" var2="1"/><action function="uremanager">journal-rollback</action><action function="page">ure_output</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_journals</action></action>
    </page>
    <page name="ure_backup">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Chunked file backup</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>Source: OS root and relative file selected in the main menu</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_backup_dir%</text><data name="ure_backup_dir"/><restrict minlen="1" maxlen="4096"/></input>
      <listbox style="group_list"><placement x="0" y="%row4_1_y%" w="%screen_w%" h="600"/>
        <listitem name="Create and review backup plan"><action function="uremanager">backup-plan</action><action function="page">ure_backup_review</action></listitem>
        <listitem name="Verify stored backup"><action function="uremanager">backup-verify</action><action function="page">ure_output</action></listitem>
        <listitem name="Revalidate source and resume stored backup"><action function="uremanager">backup-resume</action><action function="page">ure_output</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_backup_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review backup plan</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="900"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="0" w="%screen_w%" h="400"/>
          <listitem name="Confirm local destination and capture backup"><condition var1="ure_backup_hash" op="!=" var2=""/><action function="uremanager">backup-capture</action><action function="page">ure_output</action></listitem>
          <listitem name="Return; use saved manifest with host receiver"><action function="page">ure_backup</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_backup</action></action>
    </page>
    <page name="ure_raw_select">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Storage backup source</text></text>
      <listbox style="group_list"><placement x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%"/>
        <listitem name="Regular storage image"><action function="uremanager">raw-image</action><action function="page">ure_raw_source</action></listitem>
        <listitem name="Live partition or LUN; source opened read-only"><action function="uremanager">raw-live</action><action function="page">ure_raw_source</action></listitem>
        <listitem name="Show identities in Storage Graph"><action function="uremanager">storage</action><action function="page">ure_output</action></listitem>
      </listbox><template name="navbar"/><action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_raw_source">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Backup source: %ure_raw_kind%</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>Absolute image path or complete stable Storage Graph identity</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_raw_source%</text><data name="ure_raw_source"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Image sector bytes: 512 or 4096; live geometry is detected</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_raw_sector%</text><data name="ure_raw_sector"/><restrict minlen="3" maxlen="4"/></input>
      <listbox style="group_list"><placement x="0" y="%row7_1_y%" w="%screen_w%" h="%files_np_w%"/>
        <listitem name="Continue to storage backup"><action function="page">ure_raw_tools</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_raw_select</action></action>
    </page>
    <page name="ure_raw_tools">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Storage backup</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <text style="caption"><placement x="%gl_text_x%" y="0"/><text>Hash-verified bytes; no atomic snapshot or restore authorization</text></text>
        <listbox style="group_list"><placement x="0" y="80" w="%screen_w%" h="800"/>
          <listitem name="Inspect live mounts, writers, swap and USB owners"><condition var1="ure_raw_kind" var2="live"/><action function="uremanager">raw-usage</action><action function="page">ure_output</action></listitem>
          <listitem name="Select private backup directory"><action function="page">ure_raw_destination</action></listitem>
          <listitem name="Create and review source backup plan"><action function="uremanager">raw-plan</action><action function="page">ure_raw_review</action></listitem>
          <listitem name="Verify stored backup"><action function="uremanager">backup-verify</action><action function="page">ure_output</action></listitem>
          <listitem name="Revalidate selected source and resume stored backup"><action function="uremanager">raw-resume</action><action function="page">ure_output</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_raw_source</action></action>
    </page>
    <page name="ure_raw_destination">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Private backup directory</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>New capture needs a new directory on independent storage</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_backup_dir%</text><data name="ure_backup_dir"/><restrict minlen="1" maxlen="4096"/></input>
      <template name="gestures_key"/><action><touch key="back"/><action function="page">ure_raw_tools</action></action>
    </page>
    <page name="ure_raw_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review storage backup</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="720"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="760" w="%screen_w%" h="256"/>
          <listitem name="Confirm reviewed source and destination; capture backup"><condition var1="ure_backup_hash" op="!=" var2=""/><action function="uremanager">raw-capture</action><action function="page">ure_output</action></listitem>
          <listitem name="Return; transfer saved manifest to host receiver"><action function="page">ure_raw_tools</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_raw_tools</action></action>
    </page>
    <page name="ure_restore_select">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Raw restore target</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_y%"/><text>Restore the selected image. Live storage writes are unavailable.</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_raw_source%</text><data name="ure_raw_source"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Image sector bytes: 512 or 4096</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_raw_sector%</text><data name="ure_raw_sector"/><restrict minlen="3" maxlen="4"/></input>
      <listbox style="group_list"><placement x="0" y="%row7_1_y%" w="%screen_w%" h="%files_np_w%"/>
        <listitem name="Select image restore inputs"><action function="set">ure_raw_kind=image</action><action function="page">ure_restore_inputs</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_restore_inputs">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Restore source and journal</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_y%"/><text>Verified chunked backup directory</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_backup_dir%</text><data name="ure_backup_dir"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Journal parent with room for original and target bytes</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_journal_parent%</text><data name="ure_journal_parent"/><restrict minlen="1" maxlen="4096"/></input>
      <listbox style="group_list"><placement x="0" y="%row7_1_y%" w="%screen_w%" h="%files_np_w%"/>
        <listitem name="Create and review a restore plan"><action function="uremanager">restore-plan</action><action function="page">ure_restore_plan_review</action></listitem>
        <listitem name="Inspect an existing restore journal"><action function="page">ure_restore_journals</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_restore_select</action></action>
    </page>
    <page name="ure_restore_plan_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review complete image overwrite</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="800"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="820" w="%screen_w%" h="400"/>
          <listitem name="Confirm reviewed plan, preserve rollback data and restore"><condition var1="ure_restore_can_execute" var2="1"/><action function="uremanager">restore-execute</action><action function="page">ure_output</action></listitem>
          <listitem name="Return without writing image bytes"><action function="page">ure_restore_inputs</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_restore_inputs</action></action>
    </page>
    <page name="ure_restore_journals">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Restore journal directory</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_y%"/><text>Inspect current target bytes before any recovery action</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_restore_journal%</text><data name="ure_restore_journal"/><restrict minlen="1" maxlen="4096"/></input>
      <listbox style="group_list"><placement x="0" y="%row5_1_y%" w="%screen_w%" h="%files_np_w%"/>
        <listitem name="Inspect and review the selected journal"><action function="uremanager">restore-inspect</action><action function="page">ure_restore_journal_review</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_restore_inputs</action></action>
    </page>
    <page name="ure_restore_journal_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review restore recovery</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="800"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="820" w="%screen_w%" h="600"/>
          <listitem name="Confirm continuation from verified current bytes"><condition var1="ure_restore_can_resume" var2="1"/><action function="uremanager">restore-resume</action><action function="page">ure_output</action></listitem>
          <listitem name="Confirm rollback to verified pre-operation bytes"><condition var1="ure_restore_can_rollback" var2="1"/><action function="uremanager">restore-rollback</action><action function="page">ure_output</action></listitem>
          <listitem name="Confirm safe cancellation before image writes"><condition var1="ure_restore_can_cancel" var2="1"/><action function="uremanager">restore-cancel</action><action function="page">ure_output</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_restore_journals</action></action>
    </page>
    <page name="ure_gpt_select">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>GPT target</text></text>
      <listbox style="group_list"><placement x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%"/>
        <listitem name="Regular disk image; reviewed metadata writes"><action function="uremanager">gpt-image</action><action function="page">ure_gpt_source</action></listitem>
        <listitem name="Live disk or LUN; read-only backup and inspection"><action function="uremanager">gpt-live</action><action function="page">ure_gpt_source</action></listitem>
        <listitem name="Show Storage Graph identities"><action function="uremanager">storage</action><action function="page">ure_output</action></listitem>
      </listbox><template name="navbar"/><action><touch key="back"/><action function="page">ure_home</action></action>
    </page>
    <page name="ure_gpt_source">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>GPT source: %ure_gpt_kind%</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>Image path or complete sysfs:/gpt: disk identity</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_gpt_source%</text><data name="ure_gpt_source"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Image sector bytes: 512 or 4096; live geometry is detected</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_gpt_sector%</text><data name="ure_gpt_sector"/><restrict minlen="3" maxlen="4"/></input>
      <listbox style="group_list"><placement x="0" y="%row6_1_y%" w="%screen_w%" h="200"/>
        <listitem name="Continue to GPT tools"><action function="page">ure_gpt_tools</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_gpt_select</action></action>
    </page>
    <page name="ure_gpt_tools">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>GPT tools</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <text style="caption"><placement x="%gl_text_x%" y="0"/><text>Live writes are gated. Backup records are private. /tmp journals are volatile.</text></text>
        <listbox style="group_list"><placement x="0" y="80" w="%screen_w%" h="1000"/>
          <listitem name="Inspect selected target and both GPT copies"><action function="uremanager">gpt-inspect</action><action function="page">ure_output</action></listitem>
          <listitem name="Select private backup destination"><action function="page">ure_gpt_backup_destination</action></listitem>
          <listitem name="Back up GPT metadata and partition map"><action function="uremanager">gpt-backup</action><action function="page">ure_output</action></listitem>
          <listitem name="Verify stored GPT backup"><action function="uremanager">gpt-verify</action><action function="page">ure_output</action></listitem>
          <listitem name="Compare selected target with backup"><action function="uremanager">gpt-compare</action><action function="page">ure_output</action></listitem>
          <listitem name="Review repair from the sole valid GPT copy"><action function="uremanager">gpt-repair-plan</action><action function="page">ure_gpt_plan_review</action></listitem>
          <listitem name="Review restore from verified same-target backup"><action function="uremanager">gpt-restore-plan</action><action function="page">ure_gpt_plan_review</action></listitem>
          <listitem name="Select journal parent or inspect interrupted operation"><action function="page">ure_gpt_journals</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_gpt_source</action></action>
    </page>
    <page name="ure_gpt_backup_destination">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Private GPT backup directory</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>Create uses a new mode-0700 directory; verification uses an existing one</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_gpt_backup_dir%</text><data name="ure_gpt_backup_dir"/><restrict minlen="1" maxlen="4096"/></input>
      <template name="gestures_key"/><action><touch key="back"/><action function="page">ure_gpt_tools</action></action>
    </page>
    <page name="ure_gpt_journals">
      <template name="base_ex_key"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>GPT journal destinations</text></text>
      <text style="caption"><placement x="%col1_x%" y="%row1_2_y%"/><text>New journal parent; choose persistence before planning</text></text>
      <input><placement x="%col1_x%" y="%row2_2a_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_journal_parent%</text><data name="ure_journal_parent"/><restrict minlen="1" maxlen="4096"/></input>
      <text style="caption"><placement x="%col1_x%" y="%row4_1_y%"/><text>Existing journal for the selected target</text></text>
      <input><placement x="%col1_x%" y="%row5_1_y%" w="%input_w%" h="%input_height%"/><font resource="fixed"/><text>%ure_gpt_journal%</text><data name="ure_gpt_journal"/><restrict maxlen="4096"/></input>
      <listbox style="group_list"><placement x="0" y="%row6_1_y%" w="%screen_w%" h="200"/>
        <listitem name="Inspect and review current GPT journal"><action function="uremanager">gpt-journal-inspect</action><action function="page">ure_gpt_journal_review</action></listitem>
      </listbox><template name="gestures_key"/><action><touch key="back"/><action function="page">ure_gpt_tools</action></action>
    </page>
    <page name="ure_gpt_plan_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review GPT metadata transaction</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="900"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="0" w="%screen_w%" h="400"/>
          <listitem name="Confirm reviewed image plan, back up and write metadata"><condition var1="ure_gpt_can_execute" var2="1"/><action function="uremanager">gpt-execute</action><action function="page">ure_output</action></listitem>
          <listitem name="Return without writing target metadata"><action function="page">ure_gpt_tools</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_gpt_tools</action></action>
    </page>
    <page name="ure_gpt_journal_review">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review GPT journal recovery</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
        <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="900"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
        <listbox style="group_list"><placement x="0" y="0" w="%screen_w%" h="400"/>
          <listitem name="Confirm image rollback to verified original metadata"><condition var1="ure_gpt_can_rollback" var2="1"/><action function="uremanager">gpt-rollback</action><action function="page">ure_output</action></listitem>
          <listitem name="Confirm verified readback and finish commit record"><condition var1="ure_gpt_can_resume" var2="1"/><action function="uremanager">gpt-resume</action><action function="page">ure_output</action></listitem>
        </listbox>
      </scroll><template name="navbar"/><action><touch key="back"/><action function="page">ure_gpt_journals</action></action>
    </page>
    <page name="ure_save">
      <template name="base_ex"/>
      <text style="text_ab_title"><placement x="%col1_x_indent%" y="%ab_bc_y%"/><text>Review save transaction</text></text>
      <scroll x="0" y="%ab_h%" w="%screen_w%" h="%scroll_nav_h%" spacing="16" paddingtop="16" paddingbottom="40" itemheight="48">
      <textbox><placement x="%col1_x%" y="0" w="%input_w%" h="900"/><font resource="fixed"/><color foreground="%text%" background="%background%"/><text>%ure_output%</text></textbox>
      <listbox style="group_list"><placement x="0" y="0" w="%screen_w%" h="400"/>
        <listitem name="Confirm reviewed plan, back up and save"><condition var1="ure_plan_hash" op="!=" var2=""/><action function="uremanager">save</action><action function="page">ure_output</action></listitem>
        <listitem name="Return to editor"><action function="page">ure_editor</action></listitem>
      </listbox>
      </scroll>
      <template name="navbar"/>
      <action><touch key="back"/><action function="page">ure_editor</action></action>
    </page>
  </pages>
</recovery>
