// SPDX-License-Identifier: Apache-2.0
// Small dependency-free policy shared with stock recovery and fastbootd.
cc_library_headers {
    name: "libuke-recovery-write-policy-headers",
    host_supported: true,
    recovery_available: true,
    vendor_available: true,
    ramdisk_available: true,
    export_include_dirs: ["libuke"],
}

cc_library_static {
    name: "libuke-recovery",
    recovery_available: true,
    cpp_std: "c++20",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    srcs: ["libuke/core.cpp", "libuke/storage.cpp", "libuke/systems.cpp", "libuke/boot_audit.cpp", "libuke/boot_router.cpp",
           "libuke/transaction.cpp", "libuke/diagnostics.cpp", "libuke/tools.cpp",
           "libuke/cli.cpp", "libuke/editor.cpp", "libuke/backup.cpp", "libuke/installer_job.cpp", "libuke/tree.cpp", "libuke/tree_listing.cpp", "libuke/block.cpp", "libuke/gpt.cpp", "libuke/stock.cpp", "libuke/partition.cpp", "libuke/layout.cpp", "libuke/display.cpp", "libuke/ownership.cpp",
           "libuke/preflight.cpp", "libuke/device_profile.cpp", "libuke/platform.cpp", "libuke/filesystems.cpp", "libuke/partition_job.cpp", "libuke/image_ranges.cpp", "libuke/stock_job.cpp", "libuke/rescue.cpp", "libuke/rescue_resources.cpp", "libuke/gui_job.cpp", "libuke/btrfs_backup.cpp", "libuke/btrfs_manager.cpp", "libuke/management.cpp", "libuke/operation_lease.cpp", "libuke/operation_guard.cpp", "libuke/lifecycle_bridge.cpp"],
    export_include_dirs: ["libuke"],
    static_libs: ["libjsoncpp", "liblzma"],
    shared_libs: ["libcrypto", "libz", "libzstd"],
    export_static_lib_headers: ["libjsoncpp"],
}

// Explicit build target for disposable QEMU media; excluded from all products.
cc_binary {
    name: "uke-btrfs-vm-fixture",
    recovery: true,
    installable: false,
    cpp_std: "c++20",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    srcs: ["vm-btrfs-fixture.cpp"],
    static_libs: ["libuke-recovery", "libjsoncpp", "liblzma"],
    shared_libs: ["libcrypto", "libz", "libzstd"],
}
